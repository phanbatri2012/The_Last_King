{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Last King King Skill Catalog",
  "type": "object",
  "required": ["schema_version", "content_version", "progression", "skills", "active_skill_system", "active_skills", "active_skill_loadouts"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "content_version": {"type": "string", "minLength": 1},
    "progression": {
      "type": "object",
      "required": ["base_xp_to_level", "xp_growth_per_level", "choice_count"],
      "properties": {
        "base_xp_to_level": {"type": "integer", "minimum": 1},
        "xp_growth_per_level": {"type": "integer", "minimum": 0},
        "choice_count": {"type": "integer", "minimum": 1, "maximum": 5}
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "name_key", "description_key", "effect_type", "levels"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "name_key": {"type": "string", "minLength": 1},
          "description_key": {"type": "string", "minLength": 1},
          "effect_type": {"enum": ["royal_might", "swift_command", "sovereign_reach", "iron_will", "piercing_wave", "dragon_aura"]},
          "levels": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}}
          }
        },
        "additionalProperties": false
      }
    },
    "active_skill_system": {
      "type": "object",
      "required": ["resource_id", "maximum", "starting", "passive_gain_per_second", "damage_dealt_gain_per_point", "damage_taken_gain_per_point", "enemy_kill_gain", "boss_kill_gain"],
      "properties": {
        "resource_id": {"const": "rage"},
        "maximum": {"type": "number", "exclusiveMinimum": 0},
        "starting": {"type": "number", "minimum": 0},
        "passive_gain_per_second": {"type": "number", "minimum": 0},
        "damage_dealt_gain_per_point": {"type": "number", "minimum": 0},
        "damage_taken_gain_per_point": {"type": "number", "minimum": 0},
        "enemy_kill_gain": {"type": "number", "minimum": 0},
        "boss_kill_gain": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "active_skills": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "name_key", "description_key", "effect_type", "slot", "input_action", "rage_cost", "cooldown", "effect"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "name_key": {"type": "string", "minLength": 1},
          "description_key": {"type": "string", "minLength": 1},
          "effect_type": {"enum": ["directional_cone", "royal_guard", "piercing_fan"]},
          "slot": {"type": "integer", "minimum": 1, "maximum": 3},
          "input_action": {"type": "string", "pattern": "^active_skill_[1-3]$"},
          "rage_cost": {"type": "number", "exclusiveMinimum": 0},
          "cooldown": {"type": "number", "exclusiveMinimum": 0},
          "effect": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}}
        },
        "additionalProperties": false
      }
    },
    "active_skill_loadouts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["king_id", "skill_ids"],
        "properties": {
          "king_id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "skill_ids": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
