{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Last King King Skill Catalog",
  "type": "object",
  "required": ["schema_version", "content_version", "progression", "skills"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "content_version": {"type": "string", "minLength": 1},
    "progression": {
      "type": "object",
      "required": ["base_xp_to_level", "xp_growth_per_level", "choice_count"],
      "properties": {
        "base_xp_to_level": {"type": "integer", "minimum": 1},
        "xp_growth_per_level": {"type": "integer", "minimum": 0},
        "choice_count": {"type": "integer", "minimum": 1, "maximum": 5}
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "name_key", "description_key", "effect_type", "levels"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "name_key": {"type": "string", "minLength": 1},
          "description_key": {"type": "string", "minLength": 1},
          "effect_type": {"enum": ["royal_might", "swift_command", "sovereign_reach", "iron_will", "piercing_wave", "dragon_aura"]},
          "levels": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
