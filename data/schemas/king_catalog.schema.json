{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Last King king catalog",
  "type": "object",
  "required": ["schema_version", "content_version", "kings"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "content_version": {"type": "string", "minLength": 1},
    "kings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "faction_id", "name_key", "title_key", "status", "movement"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "faction_id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "name_key": {"type": "string", "minLength": 1},
          "title_key": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "movement": {
            "type": "object",
            "required": ["speed", "collision_radius"],
            "properties": {
              "speed": {"type": "number", "exclusiveMinimum": 0},
              "collision_radius": {"type": "number", "exclusiveMinimum": 0}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
