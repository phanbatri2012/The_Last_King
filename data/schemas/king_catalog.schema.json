{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Last King king catalog",
  "type": "object",
  "required": ["schema_version", "content_version", "kings"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "content_version": {"type": "string", "minLength": 1},
    "kings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "faction_id", "name_key", "title_key", "status", "weapon_archetype_id", "movement", "health", "defense", "army_capacity", "attack"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "faction_id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "name_key": {"type": "string", "minLength": 1},
          "title_key": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "weapon_archetype_id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "movement": {
            "type": "object",
            "required": ["speed", "collision_radius"],
            "properties": {
              "speed": {"type": "number", "exclusiveMinimum": 0},
              "collision_radius": {"type": "number", "exclusiveMinimum": 0}
            },
            "additionalProperties": false
          },
          "health": {
            "type": "object",
            "required": ["max"],
            "properties": {
              "max": {"type": "number", "exclusiveMinimum": 0}
            },
            "additionalProperties": false
          },
          "defense": {
            "type": "object",
            "required": ["armor", "magic_resistance"],
            "properties": {
              "armor": {"type": "number", "minimum": 0},
              "magic_resistance": {"type": "number", "minimum": 0}
            },
            "additionalProperties": false
          },
          "army_capacity": {
            "type": "object",
            "required": ["max", "unlimited"],
            "properties": {
              "max": {"type": "integer", "minimum": 1},
              "unlimited": {"type": "boolean"}
            },
            "additionalProperties": false
          },
          "attack": {
            "type": "object",
            "required": ["damage", "range", "cooldown", "target_refresh"],
            "properties": {
              "damage": {"type": "number", "exclusiveMinimum": 0},
              "range": {"type": "number", "exclusiveMinimum": 0},
              "cooldown": {"type": "number", "exclusiveMinimum": 0},
              "target_refresh": {"type": "number", "exclusiveMinimum": 0}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
