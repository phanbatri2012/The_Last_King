{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Last King enemy catalog",
  "type": "object",
  "required": ["schema_version", "content_version", "enemies"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "content_version": {"type": "string", "minLength": 1},
    "enemies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name_key", "status", "health", "movement", "attack"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "name_key": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "health": {
            "type": "object",
            "required": ["max"],
            "properties": {
              "max": {"type": "number", "exclusiveMinimum": 0}
            },
            "additionalProperties": false
          },
          "movement": {
            "type": "object",
            "required": ["speed", "collision_radius", "aggro_range"],
            "properties": {
              "speed": {"type": "number", "exclusiveMinimum": 0},
              "collision_radius": {"type": "number", "exclusiveMinimum": 0},
              "aggro_range": {"type": "number", "exclusiveMinimum": 0}
            },
            "additionalProperties": false
          },
          "attack": {
            "type": "object",
            "required": ["damage", "range", "cooldown"],
            "properties": {
              "damage": {"type": "number", "exclusiveMinimum": 0},
              "range": {"type": "number", "exclusiveMinimum": 0},
              "cooldown": {"type": "number", "exclusiveMinimum": 0}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
