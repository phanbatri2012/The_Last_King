{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Last King weapon archetype catalog",
  "type": "object",
  "required": ["schema_version", "content_version", "archetypes"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "content_version": {"type": "string", "minLength": 1},
    "archetypes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "name_key", "attack_style", "damage_type", "visual_kind", "damage_bounds", "range_bounds"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "name_key": {"type": "string", "minLength": 1},
          "attack_style": {"enum": ["melee", "ranged"]},
          "damage_type": {"enum": ["physical", "magic"]},
          "visual_kind": {"enum": ["sword", "blade", "bow", "crossbow"]},
          "damage_bounds": {"$ref": "#/$defs/positiveBounds"},
          "range_bounds": {"$ref": "#/$defs/positiveBounds"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "positiveBounds": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": {"type": "number", "exclusiveMinimum": 0},
        "max": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
